METABASE_URL=https://metabase.example.com
METABASE_API_KEY=
# api or database. Database mode explicitly replaces user/API-key API checks.
ENTITY_SOURCE=api
# Metabase APPLICATION database, not an analytics database. PostgreSQL only.
# Requires sslmode=require or stronger; prefer verify-full with an sslrootcert.
METABASE_DATABASE_URL=
POLL_INTERVAL_SECONDS=300
CHECK_RELEASES=true
STATE_PATH=/data/state.sqlite3
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=metabase-monitor@example.com
NOTIFY_EMAILS=admin@example.com,ops@example.com
# Status email on first run, then every 7 days; 0 disables.
STATUS_INTERVAL_SECONDS=604800
# Each flag permits one cleartext transport. Leave false unless you control the path.
ALLOW_INSECURE_URL=false
ALLOW_INSECURE_SMTP=false
ALLOW_INSECURE_DB=false
